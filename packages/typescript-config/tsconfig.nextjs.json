{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // apps never emit declarations — inherited declaration:true causes TS2742
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
