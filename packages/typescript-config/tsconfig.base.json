{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // one TypeScript law for every workspace package
    "target": "ES2022",
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    // Every consumer is bundler-resolved: Turbopack compiles the app and the
    // source-exported internal packages; tsx (esbuild) runs the scripts.
    // Bundler mode keeps imports extensionless ("./db"), which all of them
    // resolve. "NodeNext" is only for a package whose compiled .js is run by
    // plain node — it demands ".js" suffixes in TS source, which Turbopack
    // and tsx cannot map back to the .ts files on disk.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true, // type-only imports stay explicit
    "erasableSyntaxOnly": true, // no enums/namespaces/parameter properties
    "strict": true,
    "noUncheckedIndexedAccess": true, // index access returns T | undefined
    "noImplicitOverride": true, // overrides must be declared
    "noFallthroughCasesInSwitch": true, // switch cases must break or return
    "noUncheckedSideEffectImports": true, // side-effect imports must resolve
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "incremental": false
  }
}
